{
  "ConnectionStrings": {
    "redis": "localhost:6379"
  },
  "Services": {
    // Без Aspire адреси сервісів беруться звідси; під Aspire їх перекривають змінні services__<ресурс>__http__0.
    "auctions-api": { "http": [ "http://localhost:5180" ], "grpc": [ "http://localhost:5181" ] },
    "catalog-api": { "http": [ "http://localhost:5280" ], "grpc": [ "http://localhost:5281" ] },
    "community-api": { "http": [ "http://localhost:5380" ], "grpc": [ "http://localhost:5381" ] }
  },
  "Aggregator": {
    "AttemptTimeoutSeconds": 2,
    "TotalTimeoutSeconds": 5,
    "RecentBidsCount": 5
  },
  "OpenTelemetry": {
    "SamplingRatio": 0.25
  },
  "AllowedHosts": "*"
}
