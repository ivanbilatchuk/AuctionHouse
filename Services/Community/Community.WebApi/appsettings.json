{
  "ConnectionStrings": {
    "CommunityDb": "mongodb://localhost:27017",
    "redis": "localhost:6379"
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5380",
        "Protocols": "Http1"
      },
      "grpc": {
        "Url": "http://localhost:5381",
        "Protocols": "Http2"
      }
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "AuctionHouse_Community",
    "SeedOnStartup": true
  },
  "OpenTelemetry": {
    "SamplingRatio": 0.25
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
