{
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "SamplingRatio": 0.25
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator-route": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "auctions-route": {
        "ClusterId": "auctions",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/auctions/{**catch-all}"
        },
        "Metadata": {
          "Team": "auctions",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "bidders-route": {
        "ClusterId": "auctions",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/bidders/{**catch-all}"
        },
        "Metadata": {
          "Team": "auctions",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "items-route": {
        "ClusterId": "catalog",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/items/{**catch-all}"
        },
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "categories-route": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "tags-route": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": {
          "Path": "/api/tags/{**catch-all}"
        },
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "expert-opinions-route": {
        "ClusterId": "community",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/expert-opinions/{**catch-all}"
        },
        "Metadata": {
          "Team": "community",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "discussions-route": {
        "ClusterId": "community",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/discussions/{**catch-all}"
        },
        "Metadata": {
          "Team": "community",
          "Version": "v1"
        },
        "AuthorizationPolicy": "default"
      },
      "auth-route": {
        "ClusterId": "auth",
        "Order": 5,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "Team": "identity",
          "Version": "v1"
        }
      },
      "users-route": {
        "ClusterId": "auth",
        "Order": 5,
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Metadata": {
          "Team": "identity",
          "Version": "v1"
        }
      },
      "payments-route": {
        "ClusterId": "payments",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Metadata": {
          "Team": "payments",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "aggregator": {
            "Address": "http://aggregator"
          }
        }
      },
      "auctions": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "auctions-api": {
            "Address": "http://auctions-api"
          }
        }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-api"
          }
        }
      },
      "community": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "community-api": {
            "Address": "http://community-api"
          }
        }
      },
      "auth": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api"
          }
        }
      },
      "payments": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "payments-api": {
            "Address": "http://payments-api"
          }
        }
      }
    }
  }
}
