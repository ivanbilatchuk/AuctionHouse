{
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "SamplingRatio": 0.25
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator-route": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "auctions-route": {
        "ClusterId": "auctions",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": { "Path": "/api/auctions/{**catch-all}" },
        "Metadata": { "Team": "auctions", "Version": "v1" }
      },
      "bidders-route": {
        "ClusterId": "auctions",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": { "Path": "/api/bidders/{**catch-all}" },
        "Metadata": { "Team": "auctions", "Version": "v1" }
      },
      "items-route": {
        "ClusterId": "catalog",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": { "Path": "/api/items/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "categories-route": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "tags-route": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/tags/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "expert-opinions-route": {
        "ClusterId": "community",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": { "Path": "/api/expert-opinions/{**catch-all}" },
        "Metadata": { "Team": "community", "Version": "v1" }
      },
      "discussions-route": {
        "ClusterId": "community",
        "Order": 10,
        "MaxRequestBodySize": 1048576,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "Metadata": { "Team": "community", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "aggregator": { "Address": "http://aggregator" }
        }
      },
      "auctions": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "auctions-api": { "Address": "http://auctions-api" }
        }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "catalog-api": { "Address": "http://catalog-api" }
        }
      },
      "community": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "community-api": { "Address": "http://community-api" }
        }
      }
    }
  }
}
